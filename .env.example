# On Bothost, use the UI, not this file. Token is provided automatically by Bothost.
TELEGRAM_OWNER_ID=
# HTTPS domain routed to your bot container, needed for /login.
PUBLIC_URL=
PORT=8080
DATA_DIR=/app/data
DEFAULT_MODE=api
API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Optional: use /setup instead of specifying these here.
API_KEY=
API_MODEL=
ACCOUNT_MODEL=
CONFIRM_TOOLS=on
MODEL_TIMEOUT=180
SHELL_TIMEOUT=90
MAX_TOOL_STEPS=12
MAX_DOWNLOAD_MB=20
MAX_UPLOAD_MB=49
