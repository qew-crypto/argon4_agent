# Bothost supplies BOT_TOKEN / TELEGRAM_BOT_TOKEN automatically. Do not commit real secrets.
TELEGRAM_OWNER_ID=
PORT=8080
DATA_DIR=/app/data
DEFAULT_MODE=web
# Private, host-managed JSON; outside workspace, owned by UID 10001, chmod 600.
GEMINI_COOKIES_FILE=/app/data/secrets/gemini-cookies.json
GEMINI_WEB_MODEL=Gemini 4 Argon
# Exact visible label, if supported by the account/UI; auto = leave site's choice.
GEMINI_WEB_STRENGTH=auto
# Optional persistent profile override. Must remain outside workspace.
# GEMINI_PROFILE_DIR=/app/data/state/gemini-profile
# Optional selector overrides after inspecting the real Gemini UI on your host.
# GEMINI_INPUT_SELECTOR=rich-textarea [contenteditable="true"]
# GEMINI_MODEL_BUTTON_SELECTOR=
# GEMINI_STRENGTH_BUTTON_SELECTOR=
# GEMINI_RESPONSE_SELECTOR=model-response .markdown
API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
API_KEY=
API_MODEL=
CONFIRM_TOOLS=on
MODEL_TIMEOUT=180
SHELL_TIMEOUT=90
MAX_TOOL_STEPS=40
MAX_TASK_SECONDS=1800
MAX_DOWNLOAD_MB=20
MAX_UPLOAD_MB=49
